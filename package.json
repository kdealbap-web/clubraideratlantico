{
  "name": "club-raider-atlantico",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "seed:passwords": "node scripts/seed-passwords.mjs",
    "import:csv": "node scripts/import-csv.mjs",
    "import:csv:dry": "node scripts/import-csv.mjs --dry-run",
    "import:asistencias": "node scripts/import-asistencias.mjs",
    "import:asistencias:dry": "node scripts/import-asistencias.mjs --dry-run"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.0.14",
    "@fontsource/barlow-condensed": "^5.0.14",
    "@fontsource/bebas-neue": "^5.0.14",
    "@hookform/resolvers": "^3.9.0",
    "@supabase/supabase-js": "^2.45.4",
    "html-to-image": "^1.11.13",
    "html5-qrcode": "^2.3.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.27.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^17.6.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
