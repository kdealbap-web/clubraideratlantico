# ============================================================
# CLUB RAIDER ATLÁNTICO — Environment Variables
# Copia este archivo como .env.local para desarrollo local.
# NUNCA subas .env.local a GitHub. Configura estas vars en
# Vercel Dashboard > Project Settings > Environment Variables
# ============================================================

# --- Supabase ---
# Obtén estos valores en: app.supabase.com > Project Settings > API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# --- App Config ---
VITE_APP_NAME="Club Raider Atlántico"
VITE_APP_URL=https://clubraideratlantico.com
VITE_APP_ENV=development

# --- Fase 1+ (descomenta cuando implementes) ---
# VITE_RESEND_API_KEY=re_xxxxxxxxxxxx
# VITE_ANALYTICS_ID=G-XXXXXXXXXX
