{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/noticias/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot|Embedly|Pinterestbot|redditbot|Applebot|bingbot|Googlebot|baiduspider|YandexBot|DuckDuckBot|MJ12bot|AhrefsBot|Iframely|vkShare|W3C_Validator).*"
        }
      ],
      "destination": "/api/og?type=noticia&id=:id"
    },
    {
      "source": "/eventos/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot|Embedly|Pinterestbot|redditbot|Applebot|bingbot|Googlebot|baiduspider|YandexBot|DuckDuckBot|MJ12bot|AhrefsBot|Iframely|vkShare|W3C_Validator).*"
        }
      ],
      "destination": "/api/og?type=evento&id=:id"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
